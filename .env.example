APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
KYA_ENVIRONMENT=local
KYA_VERSION=0.0.1
KYA_LOG_LEVEL=INFO
KYA_DATABASE_URL=postgresql+asyncpg://kya:local-only-change-me@localhost:5432/kya_platform
KYA_DATABASE_MIGRATION_URL=postgresql+asyncpg://kya:local-only-change-me@localhost:5432/kya_platform
NEON_AUTH_BASE_URL=https://replace-me.neon.tech
VITE_NEON_AUTH_URL=https://replace-me.neon.tech
KYA_NEON_AUTH_ISSUER=https://replace-me.neon.tech
KYA_NEON_AUTH_JWKS_URL=https://replace-with-provisioned-jwks-url
KYA_NEON_AUTH_AUDIENCE=kya-platform
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=replace-me
OPENFGA_MODEL_ID=replace-me
KYA_INFISICAL_API_URL=https://app.infisical.com
KYA_INFISICAL_CLIENT_ID=replace-me
KYA_INFISICAL_CLIENT_SECRET=replace-me
KYA_INFISICAL_PROJECT_ID=replace-me
KYA_INFISICAL_ENVIRONMENT=staging
KYA_INFISICAL_SECRET_PATH=/
KYA_INFISICAL_ORGANIZATION_SLUG=replace-me
KYA_INFISICAL_MAXIMUM_TOKEN_TTL_SECONDS=900

# Fournisseur de déploiement par défaut. Ce choix ne limite pas les espaces KYA :
# il sélectionne uniquement l'adapter technique utilisé pour promouvoir une version.
KYA_DEPLOYMENT_PROVIDER=mock

# Neon : identifie le projet Neon qui héberge la base du Hub et ses branches éphémères.
# Ce n'est pas un projet fonctionnel KYA ; les périmètres métier sont dans KYA/OpenFGA.
KYA_NEON_PROJECT_ID=replace-me
KYA_NEON_API_KEY=replace-me

# Dokploy : regroupement technique d'applications chez Dokploy.
KYA_DOKPLOY_API_URL=https://replace-me.example
KYA_DOKPLOY_API_TOKEN=replace-me
KYA_DOKPLOY_PROJECT_ID=replace-me
KYA_DOKPLOY_PREVIEW_APP_ID=replace-me
KYA_DOKPLOY_STAGING_APP_ID=replace-me
KYA_DOKPLOY_PRODUCTION_APP_ID=replace-me

# Coolify : les UUID identifient les ressources techniques par environnement.
KYA_COOLIFY_API_URL=https://replace-me.example
KYA_COOLIFY_API_TOKEN=replace-me
KYA_COOLIFY_PREVIEW_APP_UUID=replace-me
KYA_COOLIFY_STAGING_APP_UUID=replace-me
KYA_COOLIFY_PRODUCTION_APP_UUID=replace-me
