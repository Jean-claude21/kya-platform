APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
KYA_ENVIRONMENT=local
KYA_VERSION=0.0.1
KYA_LOG_LEVEL=INFO
# Facultatif : export OTLP/HTTP vers un collecteur compatible OpenTelemetry.
KYA_OTEL_EXPORTER_OTLP_ENDPOINT=
KYA_OTEL_EXPORTER_OTLP_HEADERS=
KYA_OTEL_METRIC_EXPORT_INTERVAL_MILLIS=60000
KYA_DATABASE_URL=postgresql+asyncpg://kya:local-only-change-me@localhost:5432/kya_platform
KYA_DATABASE_MIGRATION_URL=postgresql+asyncpg://kya:local-only-change-me@localhost:5432/kya_platform
NEON_AUTH_BASE_URL=https://replace-me.neon.tech
VITE_NEON_AUTH_URL=https://replace-me.neon.tech
VITE_KYA_API_URL=http://localhost:8000
KYA_NEON_AUTH_ISSUER=https://replace-me.neon.tech
KYA_NEON_AUTH_JWKS_URL=https://replace-with-provisioned-jwks-url
KYA_NEON_AUTH_AUDIENCE=kya-platform
KYA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
KYA_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
KYA_MCP_ALLOWED_ORIGINS=[]
KYA_REGISTRY_MCP_ENABLED=false
KYA_MCP_TOOL_PROFILE_MODE=off
KYA_REGISTRY_MCP_AUTHORIZATION_SERVER_URL=https://api.kya-platform.vttlife.com
KYA_REGISTRY_MCP_RESOURCE_URL=https://mcp.kya-platform.vttlife.com/registry/mcp
# Neon Auth identifie l'humain ; le courtier KYA émet les jetons des clients MCP.
KYA_OAUTH_BROKER_ENABLED=false
KYA_OAUTH_ISSUER_URL=https://api.kya-platform.vttlife.com
KYA_OAUTH_CONSENT_URL=https://kya-platform.vttlife.com/oauth/consent
# Clé Fernet générée une fois et conservée dans Infisical, jamais committée.
KYA_OAUTH_CLIENT_SECRET_KEY=
KYA_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
KYA_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
KYA_ARTIFACT_SIGNING_KEY_ID=kya-dev-2026
KYA_ARTIFACT_SIGNING_PRIVATE_KEY=
KYA_BOOTSTRAP_OWNER_EMAIL=owner@kya-energy.com
# SHA-256 hex digest only. Keep the one-time plain code in Infisical, never here.
KYA_BOOTSTRAP_CLAIM_CODE_HASH=
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=replace-me
OPENFGA_MODEL_ID=replace-me
FGA_API_TOKEN=replace-me
KYA_INFISICAL_API_URL=https://app.infisical.com
KYA_INFISICAL_CLIENT_ID=replace-me
KYA_INFISICAL_CLIENT_SECRET=replace-me
KYA_INFISICAL_PROJECT_ID=replace-me
KYA_INFISICAL_ENVIRONMENT=staging
KYA_INFISICAL_SECRET_PATH=/
KYA_INFISICAL_ORGANIZATION_SLUG=replace-me
KYA_INFISICAL_MAXIMUM_TOKEN_TTL_SECONDS=900

# Clé dédiée aux bundles de reprise : base64 de 32 octets, conservée dans Infisical.
KYA_BACKUP_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Fournisseur de déploiement par défaut. Ce choix ne limite pas les espaces KYA :
# il sélectionne uniquement l'adapter technique utilisé pour promouvoir une version.
KYA_DEPLOYMENT_PROVIDER=mock

# Neon : identifie le projet Neon qui héberge la base du Hub et ses branches éphémères.
# Ce n'est pas un projet fonctionnel KYA ; les périmètres métier sont dans KYA/OpenFGA.
KYA_NEON_PROJECT_ID=replace-me
KYA_NEON_API_KEY=replace-me

# Dokploy : regroupement technique d'applications chez Dokploy.
KYA_DOKPLOY_API_URL=https://replace-me.example
KYA_DOKPLOY_API_TOKEN=replace-me
KYA_DOKPLOY_PROJECT_ID=replace-me
KYA_DOKPLOY_PREVIEW_APP_ID=replace-me
KYA_DOKPLOY_STAGING_APP_ID=replace-me
KYA_DOKPLOY_PRODUCTION_APP_ID=replace-me

# Coolify : les UUID identifient les ressources techniques par environnement.
KYA_COOLIFY_API_URL=https://replace-me.example
KYA_COOLIFY_API_TOKEN=replace-me
KYA_COOLIFY_PROJECT_UUID=replace-me
KYA_COOLIFY_SERVER_UUID=replace-me
KYA_COOLIFY_WEB_APPLICATION_NAME=kya-platform-web
KYA_COOLIFY_BACKEND_APPLICATION_NAME=kya-platform-backend

# Connecteur Web KYA : ces cinq variables KYA pointent actuellement vers Neon Object Storage.
# `neon deploy` fournit pour la branche les valeurs S3 AWS_* correspondantes ; Infisical les
# renomme/injecte dans KYA sans exposer les credentials ni coupler le domaine à Neon.
KYA_WEB_CAPTURE_ENABLED=false
KYA_OBJECT_STORAGE_ENDPOINT_URL=https://replace-with-branch-storage-endpoint
KYA_OBJECT_STORAGE_REGION=replace-with-neon-storage-region
KYA_OBJECT_STORAGE_BUCKET=kya-data
KYA_OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
KYA_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
