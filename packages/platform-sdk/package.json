{
  "name": "@jean-claude21/kya-platform-sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed client for KYA-Platform identity, context and governed Business APIs.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jean-claude21/kya-platform.git",
    "directory": "packages/platform-sdk"
  },
