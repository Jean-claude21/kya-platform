# Modèle à recopier dans Infisical. Ne jamais mettre les valeurs réelles dans Git.
# Les noms de projet/UUID ci-dessous sont des identifiants de fournisseur, pas des
# espaces métier KYA. Un même Hub KYA peut servir plusieurs Directions, pays et équipes.

# Neon (base du Hub + branches preview)
NEON_PROJECT_ID=
NEON_API_KEY=

# Infisical (le project id sélectionne le coffre de secrets uniquement)
INFISICAL_PROJECT_ID=

# Dokploy (facultatif si Coolify est choisi)
DOKPLOY_API_URL=
DOKPLOY_API_TOKEN=
DOKPLOY_PROJECT_ID=
DOKPLOY_PREVIEW_APP_ID=
DOKPLOY_STAGING_APP_ID=
DOKPLOY_PRODUCTION_APP_ID=

# Coolify (facultatif si Dokploy est choisi)
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_PREVIEW_APP_UUID=
COOLIFY_STAGING_APP_UUID=
COOLIFY_PRODUCTION_APP_UUID=
