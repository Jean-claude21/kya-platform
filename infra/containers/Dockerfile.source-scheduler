# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.11.28 AS uv

FROM python:3.14-slim AS build
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
RUN uv sync \
    --locked \
    --no-dev \
    --package kya-platform-backend \
    --no-install-package kya-platform-backend

COPY apps/backend apps/backend
RUN uv sync --locked --no-dev --package kya-platform-backend

FROM python:3.14-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

RUN python -m pip uninstall --yes pip
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/apps/backend /app/apps/backend

RUN useradd --no-log-init --create-home --uid 10001 kya
USER kya

CMD ["/app/.venv/bin/kya-source-scheduler"]
