# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.11.28 AS uv

FROM python:3.14-slim AS build
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
COPY capabilities/mcp/zoom/pyproject.toml capabilities/mcp/zoom/pyproject.toml
RUN uv sync \
    --locked \
    --no-dev \
    --package kya-platform-backend \
    --no-install-package kya-platform-backend \
    --no-install-package kya-zoom-mcp

COPY apps/backend apps/backend
COPY capabilities/mcp/zoom capabilities/mcp/zoom
RUN uv sync --locked --no-dev --no-editable --package kya-platform-backend
RUN /app/.venv/bin/python -c "import kya_zoom_mcp; import kya_platform.mcp.zoom.runtime"

FROM python:3.14-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

RUN python -m pip uninstall --yes pip
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/apps/backend /app/apps/backend

RUN useradd --no-log-init --create-home --uid 10001 kya
USER kya

CMD ["/app/.venv/bin/kya-web-capture-worker"]
