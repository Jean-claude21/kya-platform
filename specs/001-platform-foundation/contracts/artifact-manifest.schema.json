{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kya.energy/platform/artifact-manifest/v1",
  "title": "KYA Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "name", "version", "owners", "source", "integrity", "compatibility"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^kya:[a-z0-9-]+:[a-z0-9][a-z0-9-]*$" },
    "type": { "enum": ["app", "system", "api", "data-product", "mcp-server", "mcp-tool", "skill", "template", "model", "design-system", "connector", "policy"] },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "summary": { "type": "string", "maxLength": 500 },
    "owners": {
      "type": "object", "additionalProperties": false,
      "required": ["business", "technical", "workspace"],
      "properties": { "business": {"type":"string"}, "technical": {"type":"string"}, "workspace": {"type":"string"} }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": { "repository": {"type":"string","format":"uri"}, "commit": {"type":"string","pattern":"^[a-fA-F0-9]{40}$"}, "path": {"type":"string"} }
    },
    "integrity": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "digest"],
      "properties": { "algorithm": {"const":"sha256"}, "digest": {"type":"string","pattern":"^[a-fA-F0-9]{64}$"}, "signature": {"type":"string"} }
    },
    "compatibility": { "type": "object", "additionalProperties": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "object", "required": ["id", "range"], "properties": { "id": {"type":"string"}, "range": {"type":"string"}, "optional": {"type":"boolean","default":false} }, "additionalProperties": false } },
    "scopes": { "type": "array", "items": {"type":"string"}, "uniqueItems": true },
    "risk": { "enum": ["read", "controlled-write", "sensitive-write", "administrative"] }
  }
}
