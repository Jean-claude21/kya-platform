{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kya.energy/data/web-capture/1.0.0",
  "title": "KYA owned web capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_url", "pages", "issues"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "status_code",
          "media_type",
          "body_sha256",
          "content_trust",
          "html",
          "title",
          "language",
          "canonical_url",
          "headings",
          "text",
          "internal_links",
          "etag",
          "last_modified"
        ],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "status_code": { "type": "integer", "minimum": 200, "maximum": 299 },
          "media_type": { "enum": ["text/html", "application/xhtml+xml"] },
          "body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content_trust": { "const": "untrusted_external_content" },
          "html": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "canonical_url": { "type": ["string", "null"], "format": "uri" },
          "headings": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string" },
          "internal_links": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "etag": { "type": ["string", "null"] },
          "last_modified": { "type": ["string", "null"] }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "code"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "code": { "type": "string" }
        }
      }
    }
  }
}
